{
  "schemaVersion": 1,
  "format": "argo-workflows-receipt-cas",
  "formatVersion": 1,
  "manifestMember": "transport.json",
  "limits": {
    "entries": 1000000,
    "fileBytes": 4294967296,
    "logicalBytes": 68719476736,
    "manifestBytes": 134217728,
    "centralDirectoryBytes": 268435456,
    "pathBytes": 4096,
    "pathDepth": 128
  },
  "literalFiles": {
    "build/build.json": "{\r\n  \"binary\": \"C:\\\\original\\\\build\\\\server.exe\",  \"producer\": {\"attempt\":\"7\", \"runID\":\"fixed-local-transport\"}\r\n}\r\n",
    "native/child/results.json": " [ { \"case\" : \"retained-failure\", \"pass\" : false, \"note\" : \"原始证据\" } ]\n",
    "native/child/stdout.raw": "fixed stdout\u0000bytes\r\n",
    "native/child/stderr.raw": "independent failed-consumer evidence\n"
  },
  "positiveCases": [
    "opaque-byte-roundtrip",
    "independent-duplicate-modes",
    "detached-source",
    "physical-executable-suffixes",
    "hydrate-set",
    "legacy-docs-only"
  ],
  "refusalCases": {
    "duplicate-manifest-key": "INVALID_JSON",
    "duplicate-receipt-key": "INVALID_JSON",
    "unknown-format": "UNSUPPORTED_FORMAT",
    "unknown-manifest-field": "INVALID_INVENTORY",
    "boolean-version": "UNSUPPORTED_FORMAT",
    "boolean-size": "INVALID_INVENTORY",
    "negative-size": "INVALID_INVENTORY",
    "oversized-file": "LIMIT_EXCEEDED",
    "oversized-logical-total": "LIMIT_EXCEEDED",
    "invalid-mode": "INVALID_INVENTORY",
    "duplicate-logical-path": "PATH_ALIAS",
    "case-alias": "PATH_ALIAS",
    "file-directory-collision": "PATH_ALIAS",
    "traversal-path": "UNSAFE_PATH",
    "absolute-path": "UNSAFE_PATH",
    "drive-path": "UNSAFE_PATH",
    "backslash-path": "UNSAFE_PATH",
    "empty-component": "UNSAFE_PATH",
    "dot-component": "UNSAFE_PATH",
    "trailing-dot": "UNSAFE_PATH",
    "reserved-device": "UNSAFE_PATH",
    "noncanonical-unicode": "UNSAFE_PATH",
    "path-byte-bound": "UNSAFE_PATH",
    "path-depth-bound": "UNSAFE_PATH",
    "manifest-byte-bound": "LIMIT_EXCEEDED",
    "central-directory-bound": "LIMIT_EXCEEDED",
    "decompression-overflow": "OBJECT_MISMATCH",
    "missing-object": "OBJECT_MISMATCH",
    "extra-object": "OBJECT_MISMATCH",
    "wrong-object-hash": "OBJECT_MISMATCH",
    "wrong-object-size": "OBJECT_MISMATCH",
    "duplicate-zip-member": "UNSAFE_ARCHIVE",
    "symlink-zip-member": "UNSAFE_ARCHIVE",
    "fifo-zip-member": "UNSAFE_ARCHIVE",
    "unsupported-compression": "UNSAFE_ARCHIVE",
    "truncated-archive": "UNSAFE_ARCHIVE",
    "extra-source-file": "INVALID_INVENTORY",
    "source-symlink": "SOURCE_TYPE",
    "source-directory-symlink": "SOURCE_TYPE",
    "source-dangling-symlink": "SOURCE_TYPE",
    "source-fifo": "SOURCE_TYPE",
    "source-mutation": "SOURCE_CHANGED",
    "source-tree-after-reads": "SOURCE_CHANGED",
    "set-source-replacement": "SOURCE_CHANGED",
    "pack-output-exists": "DESTINATION_EXISTS",
    "pack-output-inside-source": "DESTINATION_UNSAFE",
    "hydrate-output-exists": "DESTINATION_EXISTS",
    "hydrate-output-symlink": "DESTINATION_UNSAFE",
    "hydrate-parent-symlink": "DESTINATION_UNSAFE",
    "report-inside-gate-tree": "DESTINATION_UNSAFE",
    "set-mixed-raw-and-cas": "INVALID_INVENTORY",
    "set-extra-file": "INVALID_INVENTORY",
    "set-duplicate-lane": "PATH_ALIAS",
    "set-native-raw": "INVALID_INVENTORY"
  }
}
